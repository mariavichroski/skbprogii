<%- include('head') %>
<link rel="stylesheet" href="eventos/css/styleeventos.css">
</head>
<%- include('menu') %>
<body>
<div class="container">
  <div> <h5 id="Cabeçalho">Você está em Eventos</h5></div>
  
  <div class="container mt-4">
    <button type="button" id="btnAbrirModal" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#eventoModal">
      Crie um evento
    </button>
   </div>
  </div>
          <table class="tabela-eventos">
        <thead>
          <tr>
            <th>Ações</th>
            <th>Descrição</th>
            <th>Prêmios</th>
            <th>Data</th>
          </tr>
          <tr>
            <th></th>
            <th><input type="text" class="form-control form-control-sm filtro-coluna" placeholder="Filtrar descrição..." /></th>
            <th><input type="text" class="form-control form-control-sm filtro-coluna" placeholder="Filtrar prêmios..." /></th>
            <th><input type="text" class="form-control form-control-sm filtro-coluna" placeholder="Filtrar data..." /></th>
          </tr>
        </thead>
        <tbody id="tabelaEventos">
          <!-- Itens aparecerão aqui -->
        </tbody>
      </table>
 

    <div class="modal fade" id="eventoModal" tabindex="-1" aria-labelledby="eventoModalLabel">
    <div class="modal-dialog" role="document">
      <form id="registrationForm" class="needs-validation" novalidate>
        <div class="modal-content">

          <div class="modal-header">
            <h5 class="modal-title" id="eventoModalLabel">Cadastro de evento</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
          </div>

          <div class="modal-body">
            <div class ="row">
              <div class="mb-3">
                <label for="descricao">Descrição:</label>
                  <input type="text" id="descricao" class="form-control" required>
                <div class="invalid-feedback">
                  Campo obrigatório.
                </div>
              </div>

              <div class="mb-3">
                <label for="premios">Prêmios:</label>
                  <input type="text" class="form-control" id="premios" required>
                <div class="invalid-feedback">
                  Campo obrigatório.
                </div>
              </div>
            </div>

            <div class="mb-3">
                <label for="data">Data:</label>
                  <input type="date" id="data" class="form-control" required>
                <div class="invalid-feedback">
                  Campo obrigatório.
                </div>
              </div>

          <div id="mensagem-erro" class="mt-3 text-danger text-center"></div>
          </div>

          <div class="modal-footer">
            <button type="submit" class="btn btn-success" id="btnSalvar">Salvar</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/eventos/js/eventos.js"></script>
<script src="/main/js/index.js"></script>
</body>
</html>