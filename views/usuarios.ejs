<%- include('head') %>
<link rel="stylesheet" href="/usuarios/css/style.css">
</head>
<%- include('menu') %>

<body>
  <div class="container mt-4">
    <button type="button" id="btnAbrirModal" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#usuarioModal">
      Crie um usuário
    </button>
  </div>

    <div class="modal fade" id="usuarioModal" tabindex="-1" aria-labelledby="usuarioModalLabel">
    <div class="modal-dialog" role="document">
      <form id="registrationForm" class="needs-validation" novalidate>
        <div class="modal-content">

          <div class="modal-header">
            <h5 class="modal-title" id="manobraModalLabel">Cadastro de Usuário</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
          </div>

          <div class="modal-body">
            <div class ="row">
              <div class="col-4 mb-2">
                <label for="name">Nome:</label>
                  <input type="text" id="name" class="form-control" required>
                <div class="invalid-feedback">
                  Campo obrigatório.
                </div>
              </div>

              <div class="col-4 mb-2">
                <label for="sobrenome">Sobrenome:</label>
                  <input type="text" class="form-control" id="sobrenome" required>
                <div class="invalid-feedback">
                  Campo obrigatório.
                </div>
              </div>
              <!-- campo para escolher tipo -->
              <div class="col-4 mb-2">
                <input type="checkbox" class="form-check-input" id="isInstrutor" name="isInstrutor">
                <label class="form-check-label" for="isInstrutor">Sou instrutor</label>
              </div>

            </div>

            <div class ="row aluno-container" id="alunoContainer">
              <div class="col-2 mb-1">
                <label for="idade">Idade:</label>
                <input type="idade" class="form-control" id="idade" required>
                <div class="invalid-feedback">
                  Campo obrigatório.
                </div>
              </div>
              <div class="col-3 mb-2">
                <label for="base">Base:</label>
                <input type="base" class="form-control" id="base" required>
                <div class="invalid-feedback">
                  Campo obrigatório.
                </div>
              </div>
              <div class="col-7 mb-2">
                <label for="turma">Turma:</label>
                  <select class="form-control" id="turma" required>
                    <option selected>Choose...</option>
                    <option value="1">T1</option>
                    <option value="2">T2</option>
                    <option value="3">T3</option>
                  </select>                
                  <div class="invalid-feedback">
                    Campo obrigatório.
                  </div>
              </div>
            </div>



            <div class ="row">
              <div class="col-12 mb-2">
                <label for="email">E-mail:</label>
                <input type="email" class="form-control" id="email" placeholder="name@example.com" required>
                <div class="invalid-feedback">
                  Campo obrigatório.
                </div>
              </div>
            </div>
            <div class ="row">
              <div class="col-12 mb-2">
                <label for="senha">Senha:</label>
                <input type="password" class="form-control" id="senha" required>
                <div class="invalid-feedback">
                  Campo obrigatório.
                </div>
              </div>
            </div>

            <div id="mensagem-erro" class="mt-3 text-danger text-center"></div>
          </div>

          <div class="modal-footer">
            <button type="submit" class="btn btn-success" id="btnSalvar">Salvar</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/usuarios/js/script.js"></script>
<script src="/main/js/index.js"></script>
</body>
</html>

